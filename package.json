    "svelte": "^5.54.0",
    "svelte-check": "^4.4.5",
    "svelte-maplibre": "^2.0.1",
    "svelte-motion": "^0.12.2",
    "svelte-sonner": "^1.1.0",
    "sveltekit-superforms": "^2.30.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tar": "^7.5.11",
    "trpc-svelte-query": "^3.0.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5",
    "zod": "^4.4.3"
  },
  "overrides": {
    "cookie": "0.7.2",
    "lodash-es": "4.18.1",
    "mysql2": "3.24.4"
  }
}
