{
  "name": "airtrail",
  "version": "3.13.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview",
    "dev": "vite dev",
    "docker:buildx:setup": "bash docker/buildx-setup.sh",
    "docker:buildx:dev": "docker buildx build --platform linux/amd64 -f docker/Dockerfile -t johly/airtrail:dev --push .",
    "docs:dev": "cd docs && bun run dev",
    "docs:generate": "cd docs && bun run generate",
    "d": "bun run dx && bun run dev",
    "dx": "bun i && bun run dx:up && bun run db:migrate-dev",
    "dx:up": "docker compose -f docker/development/compose.yml up -d --wait",
    "dx:down": "docker compose -f docker/development/compose.yml down",
    "setup": "bun run dx && bun run db:seed && bun run dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:e2e": "svelte-kit sync && tsc --noEmit -p tests/e2e/tsconfig.json",
    "lint": "prettier --check \"{src,tests/e2e,tests/screenshots}/**/*.{js,ts,html,svelte,astro,css}\" --ignore-path ./.prettierignore",
    "format": "prettier --write \"{src,tests/e2e,tests/screenshots}/**/*.{js,ts,html,svelte,astro,css}\" --ignore-path ./.prettierignore",
    "test:unit": "vitest --run --dir src --passWithNoTests",
    "test:unit:watch": "vitest --watch --dir src --passWithNoTests",
    "test:e2e": "start-server-and-test \"DISABLE_RATE_LIMITS=true OAUTH_ENABLED=true OAUTH_ALLOW_INSECURE_HTTP=true OAUTH_ISSUER_URL=http://127.0.0.1:3001/.well-known/openid-configuration OAUTH_CLIENT_ID=airtrail-e2e OAUTH_CLIENT_SECRET=airtrail-e2e OAUTH_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic OAUTH_PROMPT=select_account bun run preview --port 3000\" http://localhost:3000 \"bunx playwright test\"",
    "pretest:e2e:dev": "bun scripts/other/confirm.js \"Are you sure you want to run e2e tests? This will reset your database (yes/no)\"",
    "test:e2e:dev": "bun run db:reset && bunx playwright test && bun run db:reset",
    "test:e2e:results": "bunx playwright show-report",
    "screenshots": "bun tests/screenshots/run.ts",
    "db:migrate-dev": "prisma migrate dev",
    "db:migrate-deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:push": "prisma db push",
    "data:generate-airport-overlay": "bun scripts/data/generate-airport-overlay.js",
    "data:generate-country-tiles": "node scripts/data/generate-country-tiles.js",
    "data:generate-airport-overlay:ubicloud": "bun scripts/data/ubicloud/build-airport-overlay-on-ubicloud.ts",
    "data:publish-airport-overlay-image": "bun scripts/data/ubicloud/publish-airport-overlay-image.ts",
    "data:format": "bun scripts/data/format-data.js",
    "data:check": "bun scripts/data/format-data.js --check",
    "data:validate": "bun scripts/data/validate-data.js",
    "data:validate-icons": "bun scripts/data/validate-icons.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@node-rs/argon2": "^2.0.2",
    "@protomaps/basemaps": "^5.7.2",
    "geo-tz": "^8.1.6",
    "memoize": "^11",
    "pg": "^8.20.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@date-fns/tz": "^1.4.1",
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/extensions": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@deck.gl/maplibre": "~9.4.0",
