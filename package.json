    "@trpc/server": "^11.19.0",
    "@turf/turf": "^7.3.4",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/pg": "^8.18.0",
    "@types/pixelmatch": "^7.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/semver": "^7.7.1",
    "@xmldom/xmldom": "^0.9.10",
    "autoprefixer": "^10.4.23",
    "bits-ui": "npm:@johly/bits-ui@^2.18.12",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "date-fns": "^4.1.0",
    "devalue": "^6",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-svelte": "^3.13.1",
    "factory.ts": "^1.4.2",
    "formsnap": "^2.0.1",
    "globals": "^17.0.0",
    "hashvatar": "^0.1.2",
    "kysely": "^0.29",
    "layerchart": "^2.0.0-next.46",
    "lru-cache": "^11.2.6",
    "lucia": "^3.2.2",
    "maplibre-gl": "^6.11.2",
    "mode-watcher": "^1.1.0",
    "openid-client": "^6.8.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4",
